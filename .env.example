# ─────────────────────────────────────────────────────────────────────────────
# Hournook — environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit real values. Every secret below is read on the server only;
# none of these variables is exposed to the browser (no NEXT_PUBLIC_ prefix).
# The schema lives in src/server/env.ts and is validated at startup.
# ─────────────────────────────────────────────────────────────────────────────

# Origin THIS deployment is served from (links in emails, Stripe redirects).
# On Netlify it defaults to the site URL; set it to https://www.hournook.com in production.
APP_URL=http://localhost:3000
# Canonical public domain used for SEO (canonical tags, sitemap, Open Graph,
# JSON-LD). Defaults to https://www.hournook.com; deployments on any other host
# are automatically kept out of search engines (robots.txt + X-Robots-Tag).
# NEXT_PUBLIC_SITE_URL=https://www.hournook.com

# ── Database (PostgreSQL 16+) ────────────────────────────────────────────────
# Local default matches docker-compose.yml.
DATABASE_URL=postgres://hournook:hournook@localhost:5432/hournook
# Max connections per app instance.
DATABASE_POOL_MAX=10
# Set to true when the provider requires TLS (most managed Postgres services).
DATABASE_SSL=false
# Integration tests use a separate database whose name MUST end in _test.
TEST_DATABASE_URL=postgres://hournook:hournook@localhost:5432/hournook_test

# ── Secrets (required in production) ─────────────────────────────────────────
# Signs customer "manage booking" links. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
# Protects /api/cron/tick (sent as "Authorization: Bearer <CRON_SECRET>").
CRON_SECRET=

# Set to true only when running behind a trusted reverse proxy / load balancer
# that sets X-Forwarded-For (Vercel, Fly, Render, nginx). Used for rate limiting.
TRUST_PROXY=false

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Optional: POST JSON error reports to this URL (Slack/Discord/any webhook).
ERROR_WEBHOOK_URL=

# ── Email ────────────────────────────────────────────────────────────────────
# log (development: prints emails to the server log) | smtp | resend
# Defaults to resend/smtp when their credentials are set, else log.
# Production requires smtp or resend (or ALLOW_LOG_EMAIL_IN_PRODUCTION=1 for a trial).
EMAIL_PROVIDER=log
EMAIL_FROM=Hournook <no-reply@localhost>
# smtp://user:pass@host:587  — e.g. Mailpit from docker-compose: smtp://localhost:1025
SMTP_URL=
RESEND_API_KEY=

# ── File storage (logos, covers, avatars) ────────────────────────────────────
# local (development) | s3 (any S3-compatible store: AWS S3, Cloudflare R2, MinIO…)
# | netlify-blobs (the default when built on Netlify)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public/CDN base URL for the bucket; otherwise files are served via /media/…
S3_PUBLIC_URL=
# Single-server deployments with a persistent disk may opt in to local storage.
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=1

# ── Stripe Billing ───────────────────────────────────────────────────────────
# Use TEST MODE keys (sk_test_…). The app refuses live keys (sk_live_/rk_live_/pk_live_)
# everywhere — including deployed sites — until STRIPE_LIVE_MODE=enabled is set,
# which is meant for the final go-live step only.
# STRIPE_LIVE_MODE=
# Leave empty to run without billing (the Billing page explains it isn't set up).
STRIPE_SECRET_KEY=
# Optional: not used by the server-redirect Checkout flow.
STRIPE_PUBLISHABLE_KEY=
# Optional: only STRIPE_SECRET_KEY is required. `npm run stripe:setup` (run on
# every Netlify production build) creates the €10/month price, a Customer Portal
# configuration and the webhook endpoint, storing its secret encrypted. Set these
# only to use objects you created yourself.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# STRIPE_PORTAL_CONFIGURATION_ID=
# Enable Stripe Tax on Checkout (requires Stripe Tax to be configured).
STRIPE_AUTOMATIC_TAX=false

# ── Plan & trial ─────────────────────────────────────────────────────────────
# Free trial length for new businesses (no card required). 0 disables the trial.
TRIAL_DAYS=14
# Days a business keeps accepting bookings after a failed payment.
PAST_DUE_GRACE_DAYS=7
# Display price in minor units + currency; must match STRIPE_PRICE_ID. A price set in
# the admin panel (/admin/pricing) replaces both.
PLAN_PRICE_CENTS=1000
PLAN_CURRENCY=EUR

# ── Platform admin ───────────────────────────────────────────────────────────
# Comma-separated emails that become platform admins once verified.
PLATFORM_ADMIN_EMAILS=
# First admin, created or promoted by the Netlify build / `npm run admin:bootstrap`
# (verified email, admin rights, this password). Remove both after the first
# sign-in; while set, every deploy resets the password. See docs/ADMIN.md.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Legal & support (shown on legal pages and in emails) ─────────────────────
SUPPORT_EMAIL=
SUPPORT_URL=

# ── Optional live Stripe TEST-MODE integration tests (npm run test:stripe-live)
# Only sk_test_ keys are accepted; tests are skipped when unset.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_PRICE_ID=
